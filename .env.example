# Copy to .env and fill in values

# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider Selection
# ─────────────────────────────────────────────────────────────────────────────
# LLM_PROVIDER controls which backend all agents use. Change here only — no code changes needed.
#
# Option 1: Anthropic (default) — Claude models
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Option 2: OpenAI — GPT-4o, o3, etc.
# Install: uv add "audit-agent[openai]"
# LLM_PROVIDER=openai
# OPENAI_API_KEY=<your-openai-api-key>

# Option 3: OpenAI-compatible endpoint — vLLM, Ollama, DeepSeek, Together, Groq, LM Studio, etc.
# Install: uv add "audit-agent[openai]"
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:8000/v1    # vLLM / Ollama / LM Studio
# OPENAI_API_KEY=not-needed               # required by openai SDK, any string works for local
#
# OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=<your-openrouter-api-key>
#
# DeepSeek (hosted):
# LLM_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=<your-deepseek-api-key>
#
# Together AI:
# LLM_BASE_URL=https://api.together.xyz/v1
# OPENAI_API_KEY=<your-together-api-key>
#
# Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=<your-groq-api-key>

# Postgres
POSTGRES_URL=postgresql+asyncpg://audit:audit@localhost:5432/audit_agent
POSTGRES_URL_SYNC=postgresql://audit:audit@localhost:5432/audit_agent

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=auditpassword

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=audit-artifacts
MINIO_SECURE=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Models (defaults shown)
SCOUT_MODEL=claude-sonnet-4-6
MAPPER_MODEL=claude-sonnet-4-6
HUNTER_MODEL=claude-opus-4-7
EXPLOIT_MODEL=claude-sonnet-4-6
SKEPTIC_MODEL=claude-opus-4-7
SCRIBE_MODEL=claude-sonnet-4-6

# Thinking models served by vLLM (e.g. Qwen3): disable chain-of-thought tokens
# LLM_DISABLE_THINKING=false
# OpenRouter: cap reasoning tokens per call (0 = provider default). Thinking models
# such as Qwen3.x Max otherwise spend the whole 8192-token Hunter budget on reasoning.
# LLM_REASONING_MAX_TOKENS=2048
# OpenAI-compatible: minimum max_tokens for every call (0 = agents' own limits, 4096-8192)
# LLM_MIN_OUTPUT_TOKENS=32768

# Pipeline stages (all enabled by default)
# THREAT_MODEL_ENABLED=true
# TRIAGE_ENABLED=true
# HUNTER_NAVIGATOR_ENABLED=true
# HUNTER_EXPERTS_ENABLED=true
# HUNTER_STANDALONE_PASSES_ENABLED=true
# INVARIANT_PROVER_ENABLED=true
# CHAINER_ENABLED=true
# EXPLOIT_ENABLED=true
# SKEPTIC_ENABLED=true
# REFUTER_ENABLED=true
# ADERYN_ENABLED=true
# SEMGREP_ENABLED=true

# Benchmark baseline agent (--preset baseline): budget per contest
# BASELINE_MODEL=                 # empty → HUNTER_MODEL
# BASELINE_MAX_TOKENS=2000000
# BASELINE_MAX_SECONDS=5400
# BASELINE_MAX_STEPS=150

# Hunter throughput: in-flight LLM calls. Use 1-2 on providers with shared throughput.
# HUNTER_MAX_CONCURRENCY=8

# Benchmark: base directory for relative contest source_dir paths in datasets
# BENCHMARK_CONTESTS_DIR=/path/to/contests

# Budget
DEFAULT_BUDGET_TOKENS=500000
DEFAULT_BUDGET_USD=50.0

# Tool execution mode: strict | lenient | mock
# strict  (default) — halt audit if any tool (Docker) is unavailable
# lenient — continue with degraded mode, mark tool as unavailable in report
# mock    — skip Docker entirely (for tests without Docker daemon)
AUDIT_AGENT_TOOL_MODE=strict

# Observability
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=audit-agent
